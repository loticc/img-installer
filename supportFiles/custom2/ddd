#!/usr/bin/env bash
set -Eeuo pipefail

IMAGE_FILE="/mnt/custom.img"
LIVE_DISK=""

show_menu() {
    clear
    echo "=========================================="
    echo "       Custom2 Image Installer"
    echo "=========================================="
    echo "1. Write embedded image to disk"
    echo "0. Quit"
    echo "=========================================="
}

detect_live_disk() {
    local src real typ parent

    src="$(findmnt -rn -o SOURCE /run/live/medium 2>/dev/null | head -n1 || true)"
    src="${src%%\[*}"

    [[ -n "$src" && -b "$src" ]] || return 0

    real="$(readlink -f -- "$src")"
    typ="$(lsblk -dnro TYPE "$real" 2>/dev/null | head -n1 || true)"

    case "$typ" in
        disk)
            LIVE_DISK="$real"
            ;;
        part)
            parent="$(lsblk -dnro PKNAME "$real" 2>/dev/null | head -n1 || true)"
            if [[ -n "$parent" ]]; then
                LIVE_DISK="/dev/$parent"
            fi
            ;;
    esac
}

has_mounted_filesystems() {
    lsblk -nrpo MOUNTPOINT "$1" 2>/dev/null |
        grep -qE '[^[:space:]]'
}

# ---------------------------------------------------------------------------
# 数据分区（extroot overlay）
#
# 镜像自带的 p2 只有 1GB（squashfs 约 155MB + 内部 overlay 约 870MB），而且
# 每次升级固件都会把 p2 整块重写 → 内部 overlay 归零 → 插件全丢。
#
# 这里在 dd 完成后，把磁盘剩余空间建成独立分区 3，标签 IMMO_OVERLAY；
# 镜像里的 /etc/config/fstab 已由 patch-image.sh 烘焙好对应条目，
# 固件启动时会把 p3 直接挂成 /overlay。于是：
#   - 插件/配置拥有整盘空间（不用再手动扩容）
#   - 固件升级只重写 p1/p2，p3 不动 → 插件本体和设置都保留
# ---------------------------------------------------------------------------
CREATE_OVERLAY="1"
OVERLAY_LABEL="IMMO_OVERLAY"

part_suffix() {
    local disk="$1"
    if [[ "$disk" =~ [0-9]$ ]]; then
        printf '%sp' "$disk"
    else
        printf '%s' "$disk"
    fi
}

grow_data_partition() {
    local disk="$1" prefix part3 free_bytes size_bytes i
    local img_bytes img_sectors need_start p3_start last_usable

    [[ "$CREATE_OVERLAY" == "1" ]] || return 0

    prefix="$(part_suffix "$disk")"
    part3="${prefix}3"

    echo ""
    echo "Preparing data partition (extroot overlay) ..."

    # 关键：镜像文件的长度并不等于 p2 的末尾 —— 镜像尾部还有一段备份 GPT
    # （实测 1,107,590,656 字节 / 2,163,263 扇区，而 p2 只到 2,163,199）。
    # 如果数据分区紧贴 p2 建立，以后裸 dd 重刷镜像时，镜像尾部这 63 个扇区
    # 会正好写进分区头部 —— 而 ext4 的超级块在分区内 +1024 字节处，会被直接打坏。
    # 所以数据分区起点必须落在"镜像实际结尾 + 1MiB 对齐"之后。
    img_bytes="$(stat -c '%s' "$IMAGE_FILE" 2>/dev/null || echo 0)"
    img_sectors=$(( (img_bytes + 511) / 512 ))
    need_start=$(( ((img_sectors + 1) + 2047) / 2048 * 2048 ))

    # 镜像里的备份 GPT 是按镜像文件大小写的，落在真实盘中部；先挪到盘尾
    sgdisk -e "$disk" >/dev/null 2>&1 || true

    # 丢弃 dd 之后残留的旧分区缓存，避免后面把"陈旧节点"当成已有分区
    partprobe "$disk" >/dev/null 2>&1 || true
    blockdev --rereadpt "$disk" >/dev/null 2>&1 || true
    sleep 1

    last_usable="$(sgdisk -p "$disk" 2>/dev/null | awk '/last usable sector is/ {print $NF}')"
    if [[ -z "$last_usable" ]] || (( need_start + 600000 > last_usable )); then
        echo "WARN: 磁盘剩余空间不足（起点 ${need_start}，可用到 ${last_usable}），跳过。"
        return 0
    fi

    if sgdisk -p "$disk" 2>/dev/null | awk '$1 == 3 { found = 1 } END { exit !found }'; then
        p3_start="$(sgdisk -p "$disk" 2>/dev/null | awk '$1 == 3 { print $2 }')"
        if (( p3_start < need_start )); then
            echo "WARN: 现有分区 3 起点 ${p3_start} 早于本次镜像结尾对齐位置 ${need_start}，"
            echo "      继续刷写会覆盖它。为保护数据，安装器不处理该分区。"
            echo "      建议改用 LuCI『更新固件』在线升级（不会重写 p1/p2 以外的区域）。"
        else
            echo "Partition 3 already present at sector ${p3_start}, keeping it."
        fi
    else
        # 只新增分区，不动 p1/p2
        if ! sgdisk -n 3:"${need_start}":0 -t 3:8300 -c 3:"$OVERLAY_LABEL" "$disk" >/dev/null 2>&1; then
            echo "WARN: failed to create partition 3 (no free space?), skipped."
            return 0
        fi
        partprobe "$disk" >/dev/null 2>&1 || true
        sleep 2
        for i in 1 2 3 4 5; do
            [[ -b "$part3" ]] && break
            sleep 1
        done
        if [[ ! -b "$part3" ]]; then
            echo "WARN: partition 3 not available, skipped."
            return 0
        fi
    fi

    # 若该区域已经是带 IMMO_OVERLAY 标签的 ext4（重新刷固件后的旧数据分区），
    # 说明里面存着上次的插件与配置 —— 绝不格式化，直接沿用。
    local fs_type fs_label
    fs_type="$(blkid -o value -s TYPE "$part3" 2>/dev/null || true)"
    fs_label="$(blkid -o value -s LABEL "$part3" 2>/dev/null || true)"
    if [[ "$fs_type" == "ext4" && "$fs_label" == "$OVERLAY_LABEL" ]]; then
        echo "Existing overlay filesystem found on ${part3} (label=${fs_label}), keeping it."
        return 0
    fi

    free_bytes="$(blockdev --getsize64 "$part3" 2>/dev/null || echo 0)"
    if (( free_bytes < 300 * 1024 * 1024 )); then
        echo "WARN: partition 3 is too small (${free_bytes} bytes), skipped formatting."
        return 0
    fi

    echo "Formatting ${part3} as ext4 (label=${OVERLAY_LABEL}) ..."
    mkfs.ext4 -F -L "$OVERLAY_LABEL" -m 0 "$part3"
    sync

    size_bytes="$(blockdev --getsize64 "$part3")"
    echo "Data partition ready: ${part3}, ${size_bytes} bytes"
}

select_disk() {
    local -a all_disks=()
    local -a available_disks=()
    local disk real size model choice

    detect_live_disk

    mapfile -t all_disks < <(
        lsblk -dpnro NAME,RO,TYPE |
        awk '$2 == 0 && $3 == "disk" {print $1}'
    )

    for disk in "${all_disks[@]}"; do
        real="$(readlink -f -- "$disk")"

        if [[ -n "$LIVE_DISK" && "$real" == "$LIVE_DISK" ]]; then
            echo "Skipping live boot disk: $disk" >&2
            continue
        fi

        if has_mounted_filesystems "$disk"; then
            echo "Skipping disk with mounted filesystems: $disk" >&2
            continue
        fi

        available_disks+=("$disk")
    done

    if (( ${#available_disks[@]} == 0 )); then
        echo "Error: No eligible target disks were found." >&2
        return 1
    fi

    echo "" >&2
    echo "Available target disks:" >&2

    for i in "${!available_disks[@]}"; do
        disk="${available_disks[$i]}"
        size="$(lsblk -dnro SIZE "$disk")"
        model="$(lsblk -dnro MODEL "$disk" | xargs)"

        printf "%2d. %-15s %-12s %s\n" \
            "$((i + 1))" "$disk" "$size" "$model" >&2
    done

    while true; do
        read -r -p \
            "Select target disk (1-${#available_disks[@]}): " \
            choice </dev/tty

        if [[ "$choice" =~ ^[0-9]+$ ]] &&
           (( choice >= 1 && choice <= ${#available_disks[@]} )); then
            printf '%s\n' "${available_disks[$((choice - 1))]}"
            return 0
        fi

        echo "Invalid selection. Please try again." >&2
    done
}

# 原始磁盘镜像：直接 dd
write_raw_image() {
    local target_disk="$1"

    echo ""
    echo "Detected raw disk image. Writing with dd..."
    echo "Do not power off the system."

    if ! dd \
        if="$IMAGE_FILE" \
        of="$target_disk" \
        bs=4M \
        conv=fsync \
        status=progress; then
        echo ""
        echo "ERROR: Image writing failed."
        return 1
    fi

    sync
    echo "Raw image written successfully."

    # 把剩余空间做成独立 overlay 数据分区（p3）
    grow_data_partition "$target_disk"
}

install_image() {
    local target_disk image_size disk_size confirm model

    if [[ ! -f "$IMAGE_FILE" || ! -s "$IMAGE_FILE" ]]; then
        echo "Error: Embedded image is missing or empty:"
        echo "$IMAGE_FILE"
        return 1
    fi

    target_disk="$(select_disk)"

    if [[ ! -b "$target_disk" ]]; then
        echo "Error: Target is not a block device."
        return 1
    fi

    if has_mounted_filesystems "$target_disk"; then
        echo "Error: The target disk has mounted filesystems."
        echo "Refusing to write."
        return 1
    fi

    image_size="$(stat -c '%s' "$IMAGE_FILE")"
    disk_size="$(blockdev --getsize64 "$target_disk")"
    model="$(lsblk -dnro MODEL "$target_disk" | xargs)"

    echo ""
    echo "=========================================="
    echo "         WRITE CONFIRMATION"
    echo "=========================================="
    echo "Target disk: $target_disk"
    echo "Disk model:  $model"
    echo "Disk size:   $disk_size bytes"
    echo "Image size:  $image_size bytes"
    echo "Image type:  Raw disk image (dd)"
    echo ""

    if (( disk_size < image_size )); then
        echo "Error: The target disk is smaller than the image."
        return 1
    fi

    echo "WARNING: ALL EXISTING DATA ON THE TARGET DISK"
    echo "MAY BE PERMANENTLY ERASED."
    echo ""
    echo "To continue, type YES (case sensitive):"

    read -r -p "> " confirm </dev/tty

    if [[ "$confirm" != "YES" ]]; then
        echo "Operation cancelled."
        return 1
    fi

    echo ""
    echo "Create a persistent data partition (rest of the disk, ext4,"
    echo "label ${OVERLAY_LABEL}) to be used as /overlay?"
    echo "Recommended Y: installed packages and settings survive firmware updates,"
    echo "and no manual resizing is needed later."
    read -r -p "Create overlay partition? [Y/n]: " ans </dev/tty
    if [[ "$ans" =~ ^[Nn]$ ]]; then
        CREATE_OVERLAY="0"
        echo "Skip: falls back to the firmware's internal overlay."
    fi

    write_raw_image "$target_disk"

    echo ""
    echo "=========================================="
    echo "Operation completed."
    echo "Remove the installation media before booting"
    echo "from the target disk."
    echo "=========================================="
}

while true; do
    show_menu
    read -r -p "Enter your choice [0-1]: " choice </dev/tty

    case "$choice" in
        1)
            install_image
            break
            ;;
        0)
            echo "Exiting installer."
            exit 0
            ;;
        *)
            echo "Invalid option. Please try again."
            sleep 2
            ;;
    esac
done
